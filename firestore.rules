rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // === 공개 읽기 컬렉션 ===
    
    // 원두 정보 - 모든 사용자가 읽기 가능, 관리자만 쓰기 가능
    match /beans/{beanId} {
      allow read: if true;
      allow write: if isAdmin() || isSystemUser();
      allow create: if isAdmin() || isSystemUser();
      allow update: if isAdmin() || isSystemUser();
      allow delete: if isAdmin();
    }
    
    // 카페 정보 - 모든 사용자가 읽기 가능, 관리자만 쓰기 가능
    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin() || isSystemUser();
      allow create: if isAdmin() || isSystemUser(); 
      allow update: if isAdmin() || isSystemUser();
      allow delete: if isAdmin();
    }
    
    // === 사용자별 개인 데이터 ===
    
    // 사용자 프로필 - 본인만 읽기/쓰기 가능
    //
    // 단, 과금 필드(plan, premium_until)는 예외다. 본인 문서라고 전부 쓰게 두면
    // 브라우저 콘솔 한 줄로 프리미엄이 된다:
    //   setDoc(doc(db,'users',myUid), {plan:'premium'}, {merge:true})
    // 유료화 전체가 무력화되므로 서버(Admin SDK, 규칙 우회)만 쓰게 막는다.
    //
    // 현재 이 루트 문서를 쓰는 클라이언트 코드는 없다(읽기만 한다).
    // 쓰는 곳은 app/api/telegram-webhook 하나이고 Admin SDK라 영향받지 않는다.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(billingFields());
      // 값이 실제로 바뀐 키만 affectedKeys에 들어온다. 과금 필드를 건드리지 않는
      // 일반 프로필 수정은 그대로 통과한다.
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(billingFields());
      allow delete: if isOwner(userId);
    }
    
    // 사용자별 커피 기록 - 본인만 접근 가능
    match /users/{userId}/records/{recordId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId);
    }

    // 사용자별 커피 기록 (대화형 위저드가 쓰는 컬렉션) - 본인만 접근 가능
    match /users/{userId}/coffee_records/{recordId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId);
    }
    
    // 사용자별 찜 목록 - 본인만 접근 가능
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId);
    }
    
    // 사용자별 원두 찜 목록 - 본인만 접근 가능
    match /users/{userId}/favorites_beans/{beanId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId);
    }
    
    // 프리미엄 신청 — 본인 것만 만들고 읽는다. 문서 ID는 uid다.
    //
    // status는 운영자가 서버에서 바꾼다. 클라이언트가 'approved'로 쓸 수 있어도
    // 실제 권한은 users/{uid}.plan이 결정하므로 결제 우회는 안 되지만,
    // 신청 목록이 오염되면 누구에게 연락해야 하는지 알 수 없게 된다.
    match /premium_requests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.status == 'pending';
      // 클라이언트는 setDoc(merge)를 쓴다 — 문서가 이미 있으면 update가 된다.
      // 본인 재신청(pending 유지)까지 막으면 버튼이 조용히 실패한다.
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.uid == userId
                        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // === 알림 (재입고/가격 변동) ===

    // 원두 변경 이벤트 - 모든 사용자가 읽기 가능, 크롤러(Admin SDK)만 쓰기
    match /bean_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isSystemUser();
      allow create: if isAdmin() || isSystemUser();
      allow update, delete: if isAdmin();
    }

    // 텔레그램 연동 코드 - 본인 uid로만 생성 가능
    // 읽기/삭제는 웹훅(Admin SDK, 규칙 우회) 또는 관리자만 수행
    match /telegram_link_codes/{code} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin() || isSystemUser();
    }

    // === 시스템 데이터 ===

    // 크롤링 로그 - 시스템만 쓰기, 관리자만 읽기
    match /crawl_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSystemUser();
      allow create: if isSystemUser();
    }
    
    // 학습 데이터 - 인증된 사용자만 생성, 관리자만 관리
    match /learn_data/{learnId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // === 보안 함수 ===
    
    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 리소스 소유자인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // 과금 필드 — 클라이언트가 절대 쓰면 안 되는 키. 서버(Admin SDK)만 쓴다.
    // camelCase 변형까지 함께 막는다. 나중에 그 이름으로 코드를 짜면
    // 규칙이 조용히 비껴가기 때문이다.
    function billingFields() {
      return ['plan', 'premium_until', 'premiumUntil'];
    }

    // 관리자인지 확인 (커스텀 클레임 기반)
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.get('admin', false) == true;
    }
    
    // 시스템 사용자인지 확인 (크롤러 등)
    function isSystemUser() {
      return isAuthenticated() && 
             request.auth.token.get('system', false) == true;
    }
    
    // 데이터 유효성 검증
    function isValidBeanData() {
      return request.resource.data.keys().hasAll(['name', 'brand', 'price']) &&
             request.resource.data.name is string &&
             request.resource.data.brand is string &&
             request.resource.data.price is string;
    }
    
    function isValidCafeData() {
      return request.resource.data.keys().hasAll(['name', 'address']) &&
             request.resource.data.name is string &&
             request.resource.data.address is string;
    }
    
    function isValidRecordData() {
      return request.resource.data.keys().hasAll(['cafe', 'rating']) &&
             request.resource.data.cafe is string &&
             request.resource.data.rating is number &&
             request.resource.data.rating >= 1 &&
             request.resource.data.rating <= 5;
    }
  }
}