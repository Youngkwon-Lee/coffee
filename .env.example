# Firebase (필수)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# GLM-OCR Ollama (로컬 PC ngrok 터널)
# Vercel에서는 OLLAMA_HOST, GitHub Actions에서는 OLLAMA_TUNNEL_URL 사용
OLLAMA_HOST=https://xxxx-xx-xx-xx-xx.ngrok-free.app
OLLAMA_MODEL=glm-ocr

# PaddleOCR
# 1) 로컬 개발: python3 + scripts/paddle_ocr.py 사용
# 2) 배포 환경: 별도 PaddleOCR 서비스 엔드포인트를 지정
PADDLE_OCR_API_URL=
PADDLE_OCR_PYTHON_BIN=python3

# Slack 알림 (선택)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# 텔레그램 (수익화: 신상 원두 채널 + 즐겨찾기 재입고/가격 알림)
# BotFather에서 봇 생성 후 발급받은 토큰
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 공개 채널 ID (@채널명 또는 -100으로 시작하는 숫자 ID). 봇을 채널 관리자로 추가해야 함
TELEGRAM_CHANNEL_ID=@wondooradar
# setWebhook의 secret_token과 동일한 값 (app/api/telegram-webhook 검증용)
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
# 봇 사용자명 (@ 없이). 웹 "알림 설정" 화면의 t.me 딥링크에 사용
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=wondooradar_bot
